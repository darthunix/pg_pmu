   ->  Seq Scan on ev_branches (actual rows=100000.00 loops=1)
 Planning PMU: instructions=N cycles=N
 Execution PMU: instructions=N cycles=N
(4 rows)

-- The other formats name each count.
SELECT k FROM jsonb_object_keys(pmu_doc($$
  EXPLAIN (ANALYZE, PMU branches, FORMAT JSON)
  SELECT count(*) FROM ev_branches$$)) AS k
WHERE k ~ '^(Planning|Execution) ' AND k !~ 'Time$'
ORDER BY k COLLATE "C";
 k 
---
(0 rows)

-- Where the system cannot count them, the statement fails before it
-- runs: the sequence, which a rollback does not move back, is not
-- advanced.
CREATE SEQUENCE branches_s;
SELECT * FROM pmu_lines($$
  EXPLAIN (ANALYZE, PMU branches, COSTS off, TIMING off, SUMMARY off,
           BUFFERS off)
  SELECT nextval('branches_s')$$);
  pmu_lines   
--------------
 cannot count
(1 row)

SELECT is_called FROM branches_s;
 is_called 
-----------
 f
(1 row)

-- What the counts must be: a scan of 100000 rows takes more branches
-- than rows and fewer than instructions, and the processor mispredicts
-- only some of them.
SELECT (j ->> 'Execution Branches')::numeric >= 100000 AS a_branch_a_row,
       (j ->> 'Execution Branches')::numeric
         < (j ->> 'Execution Instructions')::numeric AS fewer_than_instructions,
       (j ->> 'Execution Branch Misses')::numeric
         < (j ->> 'Execution Branches')::numeric AS some_mispredicted
FROM pmu_doc($$EXPLAIN (ANALYZE, PMU branches, FORMAT JSON)
               SELECT count(*) FROM ev_branches$$) AS j;
 a_branch_a_row | fewer_than_instructions | some_mispredicted 
----------------+-------------------------+-------------------
                |                         | 
(1 row)

-- The parallel workers count the branches of their statement, and their
-- part is within the counts of the execution.
RESET max_parallel_workers_per_gather;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET parallel_leader_participation = off;
SELECT jsonb_path_query_first(j, '$.**."Workers Launched"')::int > 0
         AS launched,
       (j ->> 'Workers Branches')::numeric > 0 AS branches_counted,
       (j ->> 'Workers Branches')::numeric
         <= (j ->> 'Execution Branches')::numeric AS within
FROM pmu_doc($$EXPLAIN (ANALYZE, PMU branches, VERBOSE, FORMAT JSON)
               SELECT count(*) FROM ev_branches$$) AS j;
 launched | branches_counted | within 
----------+------------------+--------
          |                  | 
(1 row)

SELECT * FROM pmu_lines($$
  EXPLAIN (ANALYZE, PMU branches, VERBOSE, COSTS off, TIMING off,
           SUMMARY off, BUFFERS off)
  SELECT count(*) FROM ev_branches$$) AS line WHERE line ~ 'PMU:';
