-- Nested counting statements take cells of the pool, of which the
-- server of the suite has two. nest(n) runs n of them, one inside the
-- other.
CREATE FUNCTION nest(depth int) RETURNS int
LANGUAGE plpgsql AS $$
BEGIN
  IF depth > 0 THEN
    EXECUTE format('EXPLAIN (ANALYZE, PMU) SELECT nest(%s)', depth - 1);
  END IF;
  RETURN depth;
END
$$;
-- spec: explain-pmu/No free place
\set VERBOSITY sqlstate
EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  SELECT nest(3);
ERROR:  0A000
\set VERBOSITY default
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  SELECT nest(2)$$);
 pmu_explain  
--------------
 cannot count
(1 row)

-- A nested statement that fails inside two EXCEPTION blocks, the outer
-- one catching its error, gives its cell back in an abort: three in a
-- row, then two nested at once, all find a cell.
CREATE FUNCTION fail_nested() RETURNS int
LANGUAGE plpgsql AS $$
BEGIN
  FOR i IN 1..3 LOOP
    BEGIN
      BEGIN
        EXECUTE 'EXPLAIN (ANALYZE, PMU) SELECT 1 / 0';
      EXCEPTION WHEN unique_violation THEN
        NULL;
      END;
    EXCEPTION WHEN division_by_zero THEN
      NULL;
    END;
  END LOOP;
  EXECUTE 'EXPLAIN (ANALYZE, PMU) SELECT nest(1)';
  RETURN 3;
END
$$;
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  SELECT fail_nested()$$);
 pmu_explain  
--------------
 cannot count
(1 row)

-- The parallel workers. pmu_workers shows, from the JSON of a counting
-- EXPLAIN with VERBOSE: the workers launched, whether they counted, and
-- whether their part is within the counts of the execution.
CREATE FUNCTION pmu_workers(query text, OUT launched int,
                            OUT workers_counted bool, OUT within bool)
LANGUAGE sql AS $$
  SELECT jsonb_path_query_first(j, '$.**."Workers Launched"')::int,
         (j ->> 'Workers Instructions')::numeric > 0,
         (j ->> 'Workers Instructions')::numeric
           <= (j ->> 'Execution Instructions')::numeric
  FROM pmu_json(query) AS j
$$;
RESET max_parallel_workers_per_gather;
-- spec: explain-pmu/No workers
SELECT pmu_json($$EXPLAIN (ANALYZE, PMU, VERBOSE, FORMAT JSON)
                  SELECT count(*) FROM small$$) ? 'Workers Instructions'
       AS has_part_of_workers;
 has_part_of_workers 
---------------------
 
(1 row)

-- spec: explain-pmu/A hidden Gather
SET debug_parallel_query = regress;
SELECT j::text NOT LIKE '%Gather%' AS gather_hidden,
       (j ->> 'Workers Instructions')::numeric > 0 AS workers_counted
FROM pmu_json($$EXPLAIN (ANALYZE, PMU, VERBOSE, FORMAT JSON)
                SELECT count(*) FROM small$$) AS j;
 gather_hidden | workers_counted 
---------------+-----------------
               | 
(1 row)

RESET debug_parallel_query;
