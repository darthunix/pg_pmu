SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, VERBOSE, COSTS off, TIMING off, SUMMARY off,
           BUFFERS off)
  SELECT count(*) FROM big$$) AS line WHERE line ~ 'PMU:';
 line 
