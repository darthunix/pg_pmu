  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off,
           FORMAT XML) SELECT 1$$);
                       pmu_explain                        
----------------------------------------------------------
 <explain xmlns="http://www.postgresql.org/2009/explain">+
