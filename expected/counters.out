SELECT k, (j ->> k)::numeric > 0 AS positive
FROM pmu_json($$EXPLAIN (ANALYZE, PMU, FORMAT JSON) SELECT 1$$) j,
     unnest(ARRAY['Execution Instructions', 'Execution Cycles']) k;
           k            | positive 
------------------------+----------
 Execution Instructions | t
 Execution Cycles       | t
(2 rows)

