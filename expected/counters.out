-- spec: explain-pmu/More rows, more work
WITH s AS (SELECT pmu_json($$EXPLAIN (ANALYZE, PMU, FORMAT JSON)
                             SELECT count(*) FROM small$$) j),
     b AS (SELECT pmu_json($$EXPLAIN (ANALYZE, PMU, FORMAT JSON)
                             SELECT count(*) FROM big$$) j)
SELECT k, (b.j ->> k)::numeric > (s.j ->> k)::numeric AS larger
FROM s, b, unnest(ARRAY['Execution Instructions', 'Execution Cycles']) k;
           k            | larger 
------------------------+--------
 Execution Instructions | t
 Execution Cycles       | t
(2 rows)

-- spec: explain-pmu/Work of a function
CREATE FUNCTION count_big() RETURNS bigint
LANGUAGE plpgsql AS $$
BEGIN
  RETURN (SELECT count(*) FROM big);
END
$$;
WITH f AS (SELECT pmu_json($$EXPLAIN (ANALYZE, PMU, FORMAT JSON)
                             SELECT count_big()$$) j),
     q AS (SELECT pmu_json($$EXPLAIN (ANALYZE, PMU, FORMAT JSON)
                             SELECT count(*) FROM big$$) j)
SELECT (f.j ->> 'Execution Instructions')::numeric
       > (q.j ->> 'Execution Instructions')::numeric / 2 AS includes_its_query
FROM f, q;
 includes_its_query 
--------------------
 t
(1 row)

-- spec: explain-pmu/A rule makes two plans
CREATE TABLE ruled (a int);
CREATE TABLE copied (a int);
CREATE RULE copy AS ON INSERT TO ruled DO ALSO INSERT INTO copied VALUES (new.a);
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  INSERT INTO ruled VALUES (1)$$);
                 pmu_explain                 
---------------------------------------------
 Insert on ruled (actual rows=0.00 loops=1)
   ->  Result (actual rows=1.00 loops=1)
 Planning PMU: instructions=N cycles=N
 Execution PMU: instructions=N cycles=N
 
 Insert on copied (actual rows=0.00 loops=1)
   ->  Result (actual rows=1.00 loops=1)
 Planning PMU: instructions=N cycles=N
 Execution PMU: instructions=N cycles=N
(9 rows)

-- spec: explain-pmu/No plan
CREATE TABLE nothing (a int);
CREATE RULE none AS ON INSERT TO nothing DO INSTEAD NOTHING;
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  INSERT INTO nothing VALUES (1)$$);
        pmu_explain        
---------------------------
 Query rewrites to nothing
(1 row)

-- An EXPLAIN at the depth of the top level, where a DO block runs its
-- statements.
DO $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off,
                       SUMMARY off, BUFFERS off) SELECT count(*) FROM small'
  LOOP
    RAISE NOTICE '%', regexp_replace(line, '[0-9]+', 'N', 'g');
  END LOOP;
EXCEPTION
  WHEN OTHERS THEN
    IF SQLSTATE IN ('42501', '0A000', '53000') THEN
      RAISE NOTICE 'cannot count';
    ELSE
      RAISE;
    END IF;
END
$$;
NOTICE:  Aggregate (actual rows=N.N loops=N)
NOTICE:    ->  Seq Scan on small (actual rows=N.N loops=N)
NOTICE:  Planning PMU: instructions=N cycles=N
NOTICE:  Execution PMU: instructions=N cycles=N
-- An EXPLAIN with other statements in one call of SPI: its frame ends
-- with it, the statement after it runs as usual, and an EXPLAIN after
-- another statement counts.
DO $$
DECLARE
  n bigint;
  doc text;
BEGIN
  EXECUTE 'EXPLAIN (ANALYZE, PMU) SELECT 1; SELECT count(*) FROM small'
    INTO n;
  RAISE NOTICE 'the statement after the EXPLAIN counted % rows', n;
  EXECUTE 'SELECT 1; EXPLAIN (ANALYZE, PMU, FORMAT JSON) SELECT 2'
    INTO doc;
  RAISE NOTICE 'the EXPLAIN after a statement counted: %',
    (doc::jsonb -> 0 ->> 'Execution Instructions')::numeric > 0;
EXCEPTION
  WHEN OTHERS THEN
    IF SQLSTATE IN ('42501', '0A000', '53000') THEN
      RAISE NOTICE 'cannot count';
    ELSE
      RAISE;
    END IF;
END
$$;
NOTICE:  the statement after the EXPLAIN counted 1000 rows
NOTICE:  the EXPLAIN after a statement counted: t
-- A parameter of EXPLAIN EXECUTE that opens a cursor: the cursor's
-- executor is still open when the plan is printed, and the record of the
-- statement itself is found beside it.
CREATE FUNCTION open_cursor() RETURNS refcursor
LANGUAGE plpgsql AS $$
DECLARE
  c refcursor;
BEGIN
  OPEN c FOR SELECT g FROM small;
  RETURN c;
END
$$;
PREPARE with_cursor(refcursor) AS SELECT $1;
BEGIN;
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  EXECUTE with_cursor(open_cursor())$$);
              pmu_explain               
----------------------------------------
 Result (actual rows=1.00 loops=1)
 Execution PMU: instructions=N cycles=N
(2 rows)

COMMIT;
-- An EXPLAIN that fails inside an EXCEPTION block, and one that counts
-- after it.
DO $$
BEGIN
  BEGIN
    EXECUTE 'EXPLAIN (ANALYZE, PMU) SELECT 1 / 0';
  EXCEPTION WHEN division_by_zero THEN
    RAISE NOTICE 'the EXPLAIN failed';
  END;
EXCEPTION
  WHEN OTHERS THEN
    IF SQLSTATE IN ('42501', '0A000', '53000') THEN
      RAISE NOTICE 'cannot count';
    ELSE
      RAISE;
    END IF;
END
$$;
NOTICE:  the EXPLAIN failed
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  SELECT 1$$);
              pmu_explain               
----------------------------------------
 Result (actual rows=1.00 loops=1)
 Planning PMU: instructions=N cycles=N
 Execution PMU: instructions=N cycles=N
(3 rows)

-- spec: explain-pmu/A query planned by EXPLAIN
SELECT k, (j ->> k)::numeric > 0 AS positive
FROM pmu_json($$EXPLAIN (ANALYZE, PMU, FORMAT JSON)
                SELECT count(*) FROM small$$) j,
     unnest(ARRAY['Planning Instructions', 'Planning Cycles']) k;
           k           | positive 
-----------------------+----------
 Planning Instructions | t
 Planning Cycles       | t
(2 rows)

-- spec: explain-pmu/A prepared statement
-- The cache of prepared statements makes the plan, also during the
-- EXPLAIN, and that planning is not counted.
PREPARE count_small AS SELECT count(*) FROM small;
SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  EXECUTE count_small$$);
                      pmu_explain                      
-------------------------------------------------------
 Aggregate (actual rows=1.00 loops=1)
   ->  Seq Scan on small (actual rows=1000.00 loops=1)
 Execution PMU: instructions=N cycles=N
(3 rows)

SELECT * FROM pmu_explain($$
  EXPLAIN (ANALYZE, PMU, COSTS off, TIMING off, SUMMARY off, BUFFERS off)
  EXECUTE count_small$$);
                      pmu_explain                      
-------------------------------------------------------
 Aggregate (actual rows=1.00 loops=1)
   ->  Seq Scan on small (actual rows=1000.00 loops=1)
 Execution PMU: instructions=N cycles=N
(3 rows)

